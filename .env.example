# No environment variables or external services are required for the demo.
# Set the public origin before a production build to resolve social image URLs.
# SITE_URL=https://your-domain.example
# Optional: target an already running app instead of starting a test server.
# TEST_BASE_URL=http://localhost:3000
# Optional: override the Next.js output directory for an isolated server/build.
# NEXT_DIST_DIR=.next-custom

# Admin Subdomain & Owner Auth (admin.nookcake.shop)
ADMIN_OWNER_EMAIL=owner@nookcake.shop
ADMIN_OWNER_PASSWORD=nookcake2026
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret
# Optional custom admin host (defaults to admin.nookcake.shop / admin.localhost)
# ADMIN_HOST=admin.nookcake.shop

# MySQL Database Connection (cPanel)
# Leave unset in local dev to use built-in persistent JSON store
# DATABASE_URL=mysql://db_user:db_password@localhost:3306/nookcake_db
