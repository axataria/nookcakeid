# No environment variables or external services are required for the demo.
# Set the public origin before a production build to resolve social image URLs.
# SITE_URL=https://your-domain.example
# Optional: target an already running app instead of starting a test server.
# TEST_BASE_URL=http://localhost:3000
# Optional: override the Next.js output directory for an isolated server/build.
# NEXT_DIST_DIR=.next-custom
